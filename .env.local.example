# 배달의 만족 — environment variables (server-only)
#
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.
#
# HARD RULE: none of these may carry a `NEXT_PUBLIC_` prefix. Every value below is a
# server-only secret (DB credentials, bot token, signing key). A `NEXT_PUBLIC_` prefix
# would inline the value into the client bundle and leak it to every visitor.

# --- Neon Postgres (Vercel Marketplace) -------------------------------------
# Runtime queries use the POOLED connection string (host contains `-pooler`).
# Get it from: Neon project → Connection Details → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# drizzle-kit migrations / push use the DIRECT (non-pooled) connection string.
# Get it from: Neon project → Connection Details → uncheck "Pooled connection".
# Never run migrations over the pooled URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Telegram (initData HMAC validation, consumed in plan 02) ----------------
# Get it from: Telegram @BotFather → /newbot (or /token for an existing bot).
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyz"

# --- Session signing (jose) -------------------------------------------------
# Generate locally: openssl rand -base64 32
SESSION_SECRET="generate-with-openssl-rand-base64-32"
